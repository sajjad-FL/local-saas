# Expo Public Environment Variables
# In Expo SDK 49+, variables prefixed with EXPO_PUBLIC_ are bundled into client code and accessible via process.env.EXPO_PUBLIC_*

# Backend API Base URL:
# - For Android Emulator:    http://10.0.2.2:4000/api
# - For iOS Simulator / Web: http://localhost:4000/api
# - For Physical Device/LAN: http://<YOUR_WIFI_IP>:4000/api (e.g., http://192.168.1.50:4000/api)
EXPO_PUBLIC_API_URL=http://localhost:4000/api


# Web app address, used for the statement links the app shares (e.g. https://app.example.com).
# If unset, the API address without /api is used.
EXPO_PUBLIC_WEB_URL=http://localhost:5173
