MONGO_URL=mongodb://localhost:27017/localsaas
JWT_SECRET=change-me-in-prod
PORT=4000
# public URL of the web app; auto-reminders include the member's statement link when set
# APP_URL=https://app.example.com

# WhatsApp Cloud API — set both to enable automatic payment reminders (daily 10am)
# WA_TOKEN=
# WA_PHONE_ID=

# Behind a hosting proxy (Render, Railway, nginx): set to 1 so rate limits see real visitor IPs
# TRUST_PROXY=1

# Shown to owners whose business the platform admin has paused (e.g. your WhatsApp support number)
# SUPPORT_PHONE=9876543210
